{
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=gallery.db"
  },
  "Storage": {
    "Type": "local",
    "Local": {
      "Path": "uploads",
      "UrlPrefix": "/assets/images/uploads"
    },
    "Blob": {
      "ConnectionString": "",
      "Container": "gallery"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
